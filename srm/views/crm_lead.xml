<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field
            name="domain"
        >[('type', '=', 'opportunity'), ('request_type', '=', 'customer')]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_assigned_to_me': 1,
            'show_lead_gen_button': True,
            'show_team_switcher': True,
            'show_user_team_stages': True,
            'default_request_type': 'customer',
        }</field>
    </record>
</odoo>
